#!/usr/bin/env bash
while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|-g)
            echo "[App Encloser sudo] User/group switching ($1) is not supported in rootless containers." >&2
            exit 1
            ;;
        -p)
            shift 2
            ;;
        -E|-h|-k|-K|-v|-V|-s|-i)
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done
exec "$@"
